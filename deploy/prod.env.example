# Production settings. Copy to /etc/codesentinel/prod.env (install script does this) and keep it chmod 600.
POSTGRES_DB=codesentinel
POSTGRES_USER=codesentinel
POSTGRES_PASSWORD=__GENERATED__
DB_URL=jdbc:postgresql://127.0.0.1:5432/codesentinel
JWT_SECRET=__GENERATED__
JWT_TTL_MINUTES=240
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# The backend serves the built UI itself (one origin, no CORS needed)
STATIC_DIR=/opt/codesentinel/frontend/dist
CORS_ORIGIN=https://example.invalid
# Only 'framework' when a trusted proxy (Caddy / Cloudflare Tunnel) sits in front; makes client IPs and https correct
FORWARD_HEADERS=framework
RATE_LIMIT_PER_MINUTE=30
STORAGE_ROOT=/var/lib/codesentinel/storage
STORAGE_PROVIDER=local
REGISTRATION_ENABLED=true
SEED_DEMO=false
BOOTSTRAP_INSTRUCTOR_EMAIL=
BOOTSTRAP_INSTRUCTOR_PASSWORD=
DOCKER_BIN=docker
JUDGE_WORKER_ENABLED=true
