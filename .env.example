# Copy to .env and edit. Every value here is a PLACEHOLDER; never commit the real .env.

# --- PostgreSQL (compose.yaml reads these too) ---
POSTGRES_DB=codesentinel
POSTGRES_USER=codesentinel
POSTGRES_PASSWORD=change-me-local-only
DB_URL=jdbc:postgresql://127.0.0.1:5432/codesentinel

# --- Backend ---
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_TTL_MINUTES=480
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Allowed browser origin for the Vite dev server
CORS_ORIGIN=http://127.0.0.1:5173

# Where private files live (outside any web root). Relative paths resolve from the repo root.
STORAGE_ROOT=./storage
STORAGE_PROVIDER=local

# Student self-registration requires a course enrollment code in the demo.
REGISTRATION_ENABLED=true

# One-time instructor bootstrap (no public instructor sign-up exists). Leave blank to skip.
BOOTSTRAP_INSTRUCTOR_EMAIL=
BOOTSTRAP_INSTRUCTOR_PASSWORD=

# --- Plagiarism engine (triage settings, not proof of misconduct) ---
PLAG_K=10
PLAG_W=5
PLAG_CANDIDATE_CUTOFF=0.30
PLAG_HIGH_PRIORITY_THRESHOLD=0.80

# --- Judge / sandbox ---
DOCKER_BIN=docker
JUDGE_WORKER_ENABLED=true
JUDGE_POLL_MILLIS=1500


